<?xml version="1.0" encoding="UTF-8"?>

<diccionarioDatos>

    <!-- ================================================= -->
    <!-- ESTUDIANTE -->
    <!-- ================================================= -->

    <entidad nombre="Estudiante" codigo="DD-01">

        <campo>
            <nombre>id_estudiante</nombre>
            <tipo>Entero</tipo>
            <longitud>5</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Identificador único del estudiante.</descripcion>
            <ejemplo>10245</ejemplo>
        </campo>

        <campo>
            <nombre>nombre</nombre>
            <tipo>Texto</tipo>
            <longitud>50</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Nombre del estudiante.</descripcion>
            <ejemplo>Jose</ejemplo>
        </campo>

        <campo>
            <nombre>apellido</nombre>
            <tipo>Texto</tipo>
            <longitud>50</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Apellido del estudiante.</descripcion>
            <ejemplo>Solorzano</ejemplo>
        </campo>

        <campo>
            <nombre>cif</nombre>
            <tipo>Texto</tipo>
            <longitud>15</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Codigo de identificacion del estudiante.</descripcion>
            <ejemplo>20261234</ejemplo>
        </campo>

        <campo>
            <nombre>correo</nombre>
            <tipo>Texto</tipo>
            <longitud>100</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Correo electronico del estudiante.</descripcion>
            <ejemplo>estudiante@uam.edu.ni</ejemplo>
        </campo>

        <campo>
            <nombre>carrera</nombre>
            <tipo>Texto</tipo>
            <longitud>100</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Carrera universitaria que cursa el estudiante.</descripcion>
            <ejemplo>Ingenieria en Sistemas</ejemplo>
        </campo>

        <campo>
            <nombre>semestre</nombre>
            <tipo>Entero</tipo>
            <longitud>2</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Semestre academico actual del estudiante.</descripcion>
            <ejemplo>2</ejemplo>
        </campo>

        <campo>
            <nombre>estado</nombre>
            <tipo>Texto</tipo>
            <longitud>20</longitud>
            <obligatorio>Si</obligatorio>
            <dominio>Activo, Inactivo</dominio>
            <descripcion>Estado actual del estudiante dentro del sistema.</descripcion>
            <ejemplo>Activo</ejemplo>
        </campo>

    </entidad>


    <!-- ================================================= -->
    <!-- ACTIVIDAD -->
    <!-- ================================================= -->

    <entidad nombre="Actividad" codigo="DD-02">

        <campo>
            <nombre>id_actividad</nombre>
            <tipo>Entero</tipo>
            <longitud>6</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Identificador unico de la actividad.</descripcion>
            <ejemplo>10025</ejemplo>
        </campo>

        <campo>
            <nombre>id_estudiante</nombre>
            <tipo>Entero</tipo>
            <longitud>5</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Identificador del estudiante que realizo la actividad.</descripcion>
            <ejemplo>10245</ejemplo>
        </campo>

        <campo>
            <nombre>id_categoria</nombre>
            <tipo>Entero</tipo>
            <longitud>3</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Identificador de la categoria de la actividad.</descripcion>
            <ejemplo>1</ejemplo>
        </campo>

        <campo>
            <nombre>nombre_actividad</nombre>
            <tipo>Texto</tipo>
            <longitud>100</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Nombre de la actividad realizada.</descripcion>
            <ejemplo>Apoyo en evento universitario</ejemplo>
        </campo>

        <campo>
            <nombre>descripcion</nombre>
            <tipo>Texto</tipo>
            <longitud>250</longitud>
            <obligatorio>No</obligatorio>
            <descripcion>Descripcion detallada de la actividad.</descripcion>
            <ejemplo>Apoyo durante evento deportivo.</ejemplo>
        </campo>

        <campo>
            <nombre>fecha</nombre>
            <tipo>Fecha</tipo>
            <longitud>10</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Fecha en que se realizo la actividad.</descripcion>
            <ejemplo>2026-09-20</ejemplo>
        </campo>

        <campo>
            <nombre>hora_inicio</nombre>
            <tipo>Hora</tipo>
            <longitud>5</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Hora en que inicio la actividad.</descripcion>
            <ejemplo>08:00</ejemplo>
        </campo>

        <campo>
            <nombre>hora_fin</nombre>
            <tipo>Hora</tipo>
            <longitud>5</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Hora en que finalizo la actividad.</descripcion>
            <ejemplo>12:00</ejemplo>
        </campo>

        <campo>
            <nombre>horas</nombre>
            <tipo>Decimal</tipo>
            <longitud>5,2</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Cantidad de horas realizadas en la actividad.</descripcion>
            <ejemplo>4.00</ejemplo>
        </campo>

        <campo>
            <nombre>estado</nombre>
            <tipo>Texto</tipo>
            <longitud>20</longitud>
            <obligatorio>Si</obligatorio>
            <dominio>Pendiente, Aprobada, Rechazada</dominio>
            <descripcion>Estado actual de la actividad.</descripcion>
            <ejemplo>Pendiente</ejemplo>
        </campo>

        <campo>
            <nombre>observacion</nombre>
            <tipo>Texto</tipo>
            <longitud>250</longitud>
            <obligatorio>No</obligatorio>
            <descripcion>Comentario adicional relacionado con la actividad.</descripcion>
            <ejemplo>Actividad pendiente de revision.</ejemplo>
        </campo>

    </entidad>


    <!-- ================================================= -->
    <!-- EVIDENCIA -->
    <!-- ================================================= -->

    <entidad nombre="Evidencia" codigo="DD-03">

        <campo>
            <nombre>id_evidencia</nombre>
            <tipo>Entero</tipo>
            <longitud>6</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Identificador unico de la evidencia.</descripcion>
            <ejemplo>50025</ejemplo>
        </campo>

        <campo>
            <nombre>id_actividad</nombre>
            <tipo>Entero</tipo>
            <longitud>6</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Identificador de la actividad a la que pertenece la evidencia.</descripcion>
            <ejemplo>10025</ejemplo>
        </campo>

        <campo>
            <nombre>nombre_archivo</nombre>
            <tipo>Texto</tipo>
            <longitud>150</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Nombre del archivo utilizado como evidencia.</descripcion>
            <ejemplo>comprobante01.jpg</ejemplo>
        </campo>

        <campo>
            <nombre>tipo_archivo</nombre>
            <tipo>Texto</tipo>
            <longitud>20</longitud>
            <obligatorio>Si</obligatorio>
            <dominio>JPG, PNG, PDF</dominio>
            <descripcion>Formato del archivo de evidencia.</descripcion>
            <ejemplo>JPG</ejemplo>
        </campo>

        <campo>
            <nombre>ruta_archivo</nombre>
            <tipo>Texto</tipo>
            <longitud>250</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Ubicacion donde se encuentra almacenado el archivo.</descripcion>
            <ejemplo>uploads/comprobante01.jpg</ejemplo>
        </campo>

        <campo>
            <nombre>fecha_subida</nombre>
            <tipo>Fecha</tipo>
            <longitud>10</longitud>
            <obligatorio>Si</obligatorio>
            <descripcion>Fecha en que se registro la evidencia.</descripcion>
            <ejemplo>2026-09-20</ejemplo>
        </campo>

        <campo>
            <nombre>estado</nombre>
            <tipo>Texto</tipo>
            <longitud>20</longitud>
            <obligatorio>Si</obligatorio>
            <dominio>Pendiente, Aprobada, Rechazada</dominio>
            <descripcion>Estado de revision de la evidencia.</descripcion>
            <ejemplo>Pendiente</ejemplo>
        </campo>

    </entidad>


